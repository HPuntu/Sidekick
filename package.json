{
  "name": "obsidian-sidekick",
  "version": "0.1.6",
  "description": "A local-first sidekick for Pi and Ollama agent workflows.",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "package": "node scripts/package-release.mjs",
    "release:check": "npm run typecheck && npm run sync:version && npm run build && npm audit --omit=dev",
    "release:verify-tag": "node scripts/verify-release-tag.mjs",
    "release:zip": "npm run release:check && npm run package",
    "sync:version": "node scripts/sync-version.mjs",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "agent",
    "ollama",
    "dashboard",
    "sidekick"
  ],
  "author": "HPuntu",
  "license": "MIT",
  "files": [
    "main.js",
    "manifest.json",
    "styles.css"
  ],
  "devDependencies": {
    "@types/node": "^20.11.30",
    "esbuild": "^0.28.0",
    "obsidian": "^1.5.12",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  }
}
